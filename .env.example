# Copie este arquivo para ".env" e preencha com as credenciais do SEU projeto Firebase
# (Console Firebase > Configurações do Projeto > Seus apps > Config SDK).
#
# IMPORTANTE: o arquivo ".env" nunca deve ser commitado no Git (já está no .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Namespace usado para separar os dados no Realtime Database — precisa bater
# EXATAMENTE com o que está em database.rules.json (minúsculo: "luary")
VITE_APP_NAMESPACE=luary
